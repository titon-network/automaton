# Disable the pnpm 10.x supply-chain minimum-release-age policy for this
# package — we publish + consume same-day across forgeton/atlas/fortuna/
# kronos/phoebe/themis SDKs and the policy would block every release day.
# Per-package scope: this only affects automaton's install; third-party
# projects pinning automaton are unaffected.
minimum-release-age=0
minimumReleaseAge=0
# Skip pnpm's "run-script triggers pnpm install if deps drift" check.
# Without this, `pnpm run build` re-invokes install which reapplies the
# supply-chain policy and ignores our --config overrides.
verify-deps-before-run=false
