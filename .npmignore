# Files NOT to ship in the npm tarball.
#
# pnpm/npm pack uses this when present (else falls back to .gitignore).
# Without it, `files: ["contrib"]` in package.json includes EVERY file
# under contrib/ — including any local terraform state / provider plugins
# the operator generated by running `terraform init` in those module
# directories. Those dirs can be hundreds of MB; explicit exclusion below.

# Terraform — local state + provider plugins.
contrib/aws/lightsail/.terraform
contrib/aws/lightsail/.terraform.lock.hcl
contrib/aws/terraform/.terraform
contrib/aws/terraform/.terraform.lock.hcl
contrib/aws/lightsail/terraform.tfstate
contrib/aws/lightsail/terraform.tfstate.backup
contrib/aws/terraform/terraform.tfstate
contrib/aws/terraform/terraform.tfstate.backup
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Editor / OS junk that might sneak into contrib/ over time.
*.swp
*~
.DS_Store
Thumbs.db

# Test artifacts (in case anyone leaves them around).
coverage/
.nyc_output/
*.tsbuildinfo
