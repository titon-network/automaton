# Dependencies
node_modules/
.pnpm-store/

# TypeScript build output
dist/

# IDE / editor
.idea/
*.iml
.vscode/
*.swp
*~
.DS_Store
.history/

# Logs
*.log
npm-debug.log*

# Local env
.env
.env.local

# Coverage
coverage/
.nyc_output/

# TypeScript incremental build info
*.tsbuildinfo

# OS junk
Thumbs.db
ehthumbs.db
desktop.ini

# Package archives — `pnpm pack` / `npm pack` output should never be tracked
*.tgz
*.tar.gz

# Local operator state (never commit wallet keystore or config)
.titon/

# Terraform — provider plugins, local state, planfiles. The module
# *source* under contrib/aws/{terraform,lightsail}/ is shipped, but
# anything generated by `terraform init/plan/apply` is local-only.
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Claude Code workspace settings (per-machine, not for the public repo)
.claude/
