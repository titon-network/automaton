#!/bin/bash
# titon-fetch-secrets — re-pull all operator secrets from SSM and
# materialise them on disk. Generated by the EC2 module's user-data
# at first boot — DO NOT hand-edit, terraform apply rewrites it.
#
# Called from:
#   1. cloud-init at first boot (one-shot, populates /etc/automaton.env
#      so the daemon can start the first time).
#   2. systemd's ExecStartPre on every titon-automaton.service start —
#      so an operator who rotates the SSM password and then runs
#      `systemctl restart titon-automaton` picks up the new value.
#
# Idempotent. Atomic per file (write-tmp + rename + chmod + chown).
set -euo pipefail

STATE_DIR="${state_dir}"
SSM_PATH="${ssm_path}"
AWS_REGION="${aws_region}"
NETWORK="${network}"
ENABLE_FORTUNA="${enable_fortuna}"
RPC_URL="${rpc_url}"
RPC_API_KEY="${rpc_api_key}"
NONROOT_UID=65532

fetch_ssm() {
    local name="$1"
    local out="$2"
    local mode="$3"
    if ! aws ssm get-parameter \
        --region "$AWS_REGION" \
        --name "$name" \
        --with-decryption \
        --query 'Parameter.Value' \
        --output text > "$out.tmp"; then
        echo "FATAL: missing SSM parameter $name" >&2
        rm -f "$out.tmp"
        exit 1
    fi
    chmod "$mode" "$out.tmp"
    mv "$out.tmp" "$out"
}

mkdir -p "$STATE_DIR/automaton"

# wallet.enc — base64-encoded SecureString, decoded back to the raw
# encrypted JSON keystore the daemon expects.
fetch_ssm "$SSM_PATH/wallet.enc" /tmp/wallet.enc.b64 600
base64 -d < /tmp/wallet.enc.b64 > "$STATE_DIR/automaton/wallet.enc"
rm -f /tmp/wallet.enc.b64
chmod 600 "$STATE_DIR/automaton/wallet.enc"

# config.json — operator-supplied SSM override OR synthesised from
# the module's network / rpc vars (baked at apply time). We
# distinguish "param not present" (fall back to synthesis) from any
# other error (auth, throttling, network) — the latter must NOT fall
# through silently, since synthesis would produce an unintended config.
config_err=$(aws ssm get-parameter \
    --region "$AWS_REGION" \
    --name "$SSM_PATH/config.json" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text 2>&1 > /tmp/config.json.tmp) || true
if [ -s /tmp/config.json.tmp ] && [ -z "$config_err" ]; then
    install -m 600 /tmp/config.json.tmp "$STATE_DIR/automaton/config.json"
    rm -f /tmp/config.json.tmp
elif echo "$config_err" | grep -q ParameterNotFound; then
    rm -f /tmp/config.json.tmp
    if [ -n "$RPC_API_KEY" ]; then
        ENDPOINT_JSON=$(jq -n --arg url "$RPC_URL" --arg key "$RPC_API_KEY" '{url: $url, apiKey: $key}')
    else
        ENDPOINT_JSON=$(jq -n --arg url "$RPC_URL" '{url: $url}')
    fi
    cat > "$STATE_DIR/automaton/config.json" <<CONFIG_EOF
{
  "configVersion": 1,
  "network": "$NETWORK",
  "endpoints": [$ENDPOINT_JSON],
  "walletVersion": "v5r1",
  "metricsPort": 9090,
  "metricsHost": "127.0.0.1",
  "pollIntervalMs": 10000,
  "gaugeSnapshotEveryNTicks": 6,
  "maxGasPerExecute": "0.5",
  "minFreeBalance": "2.0",
  "logLevel": "info",
  "products": { "kronos": true, "fortuna": $ENABLE_FORTUNA }
}
CONFIG_EOF
    chmod 600 "$STATE_DIR/automaton/config.json"
else
    echo "FATAL: failed to read $SSM_PATH/config.json: $config_err" >&2
    rm -f /tmp/config.json.tmp
    exit 1
fi

# bls.enc — only when Fortuna is enabled at the module level.
if [ "$ENABLE_FORTUNA" = "true" ]; then
    fetch_ssm "$SSM_PATH/bls.enc" /tmp/bls.enc.b64 600
    base64 -d < /tmp/bls.enc.b64 > "$STATE_DIR/automaton/bls.enc"
    rm -f /tmp/bls.enc.b64
    chmod 600 "$STATE_DIR/automaton/bls.enc"
fi

chown -R "$NONROOT_UID:$NONROOT_UID" "$STATE_DIR"

# password — root-only env file. systemd reads it via EnvironmentFile=
# BEFORE the User= privilege drop, so the daemon process inherits
# AUTOMATON_PASSWORD without any unprivileged user needing read access
# to /etc/automaton.env.
fetch_ssm "$SSM_PATH/password" /tmp/automaton.password 600
{
    printf '# Generated by titon-fetch-secrets — DO NOT COMMIT.\n'
    printf 'AUTOMATON_PASSWORD=%s\n' "$(cat /tmp/automaton.password)"
} > /etc/automaton.env
chmod 600 /etc/automaton.env
chown root:root /etc/automaton.env
shred -u /tmp/automaton.password 2>/dev/null || rm -f /tmp/automaton.password
