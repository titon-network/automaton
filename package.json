{
    "name": "@titon/automaton",
    "version": "0.1.0",
    "description": "Production-ready off-chain automaton node for the Titon protocol suite (Kronos automation, Fortuna VRF). Stake once with ForgeTON, earn across every admitted consumer product.",
    "license": "MIT",
    "keywords": [
        "ton",
        "titon",
        "kronos",
        "forgeton",
        "automaton",
        "shared-security",
        "restaking",
        "automation",
        "blockchain"
    ],
    "bin": {
        "automaton": "./dist/cli/index.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "contrib",
        "README.md",
        "AGENTS.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "test": "jest --runInBand",
        "cli": "node dist/cli/index.js",
        "sync:sdks": "cd ../forgeton/sdk && pnpm run build && cd ../../kronos/sdk && pnpm run build && cd ../../automaton && pnpm install --force"
    },
    "dependencies": {
        "@ton/core": "^0.63.0",
        "@ton/crypto": "^3.3.0",
        "@ton/ton": "^15.3.0",
        "commander": "^12.1.0",
        "forgeton-sdk": "file:../forgeton/sdk",
        "kronos-sdk": "file:../kronos/sdk",
        "pino": "^9.5.0",
        "prom-client": "^15.1.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "jest": "^30.0.0",
        "pino-pretty": "^11.3.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=22"
    }
}
